{
  "name": "ai-bridge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:daemon": "bun build src/cli/index.ts --target=node --outfile=dist/ai-bridge",
    "build:userscript": "pnpm --prefix userscript build",
    "build": "pnpm build:daemon && pnpm build:userscript",
    "run:clipboard": "./dist/ai-bridge clipboard",
    "typecheck": "pnpm --filter . exec tsc --noEmit && pnpm --filter userscript exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "pnpm build:daemon && ./dist/ai-bridge server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "bin": {
    "ai-bridge": "src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "find-process": "^2.1.1",
    "tsx": "^4.22.4"
  }
}
