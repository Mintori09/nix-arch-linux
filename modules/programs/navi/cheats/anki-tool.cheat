% anki-tool

# Create anki apkg file for vocabulary
anki-tool --type vocab <json_files>

# Create anki apkg file for mcq
anki-tool --type mcq <json_files>

# Create anki apkg file for mcq with shuffled options
anki-tool --type mcq-shuffle <json_files>

# Create anki apkg file for basic question
anki-tool --type basic <json_files>

# Create anki apkg file for Japanese grammar
anki-tool --type jp_grammar <json_files>

# Extract apkg file
anki-tool --export "<apkg_file>"

$ json_files: fd -e json --- --multi --expand
$ apkg_file: fd -e apkg
