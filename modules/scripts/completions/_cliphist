#compdef cliphist

zstyle ':completion:*:*:cliphist:*' prefix-needed false

_cliphist() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  _arguments -s -C \
    '-max-items=[Maximum number of items to store]:num:' \
    '-max-dedupe-search=[Maximum items to search for deduplication]:num:' \
    '-preview-width=[Maximum preview width]:width:' \
    '-db-path=[Path to database]:db:_files' \
    '-version[Show version]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->subargs' && ret=0

  case "$state" in
    subcmd)
      local -a subcommands
      subcommands=(
        'store:Store clipboard entry from stdin'
        'list:List stored clipboard entries'
        'decode:Decode an entry to stdout'
        'delete:Delete an entry'
        'delete-query:Delete entries matching query'
        'wipe:Wipe all clipboard history'
        'version:Show version'
      )
      _describe -t subcommands 'cliphist command' subcommands && ret=0
      ;;
  esac

  return ret
}

_cliphist "$@"
