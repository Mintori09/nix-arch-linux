#compdef defuddle

zstyle ':completion:*:*:defuddle:*' prefix-needed false

_defuddle() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  _arguments -C \
    '(-V --version)'{-V,--version}'[Output version number]' \
    '(-h --help)'{-h,--help}'[Display help]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->subargs' && ret=0

  case "$state" in
    subcmd)
      local -a subcommands
      subcommands=(
        'parse:Parse HTML content from a file or URL'
        'help:Display help for command'
      )
      _describe -t subcommands 'defuddle command' subcommands && ret=0
      ;;
    subargs)
      case "$words[1]" in
        parse)
          _arguments -s -S \
            '(-m --markdown)'{-m,--markdown}'[Output as Markdown]' \
            '(-j --json)'{-j,--json}'[Output as JSON]' \
            '(-o --output)'{-o,--output}'=[Output file]:output:_files' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '1:source (file or URL):_files' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_defuddle "$@"
