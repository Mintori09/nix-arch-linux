# ----------------------------------------------------------------------
# Dynamic Helpers for yay (Fast, low-latency, accurate package listing)
# ----------------------------------------------------------------------

# Dynamic completion for installed packages (used in -R, -Q, etc.)
# Reads /var/lib/pacman/local/*/desc directly using Perl (<30ms)
# Emits "name:description" cleanly escaped for _describe
_yay_installed_packages() {
  local -a pkgs
  local pkg_data
  pkg_data=$(perl -e '
    use strict;
    use warnings;
    my @out;
    for my $dir (glob("/var/lib/pacman/local/*")) {
      if (open(my $fh, "<", "$dir/desc")) {
        my ($name, $desc);
        while (<$fh>) {
          chomp;
          if ($_ eq "%NAME%") { $name = <$fh>; chomp($name); }
          elsif ($_ eq "%DESC%") { $desc = <$fh>; chomp($desc); }
          last if ($name && $desc);
        }
        close($fh);
        if ($name) {
          $desc //= $name;
          $desc =~ s/[:\[\]\x00-\x1f]/ /g;
          push @out, "$name:$desc\n";
        }
      }
    }
    print @out;
  ' 2>/dev/null)

  if [[ -n "$pkg_data" ]]; then
    pkgs=( ${(f)pkg_data} )
    _describe -t installed-packages 'installed package' pkgs
  else
    local -a pkgs_fallback
    setopt localoptions extendedglob
    pkgs_fallback=( /var/lib/pacman/local/*(/) )
    pkgs_fallback=( ${${pkgs_fallback#/var/lib/pacman/local/}%-*-*} )
    _wanted installed-packages expl 'installed package' compadd -a pkgs_fallback
  fi
}

# Dynamic completion for explicitly installed packages
_yay_explicit_packages() {
  local -a pkgs
  local pkg_data
  pkg_data=$(perl -e '
    use strict;
    use warnings;
    my %explicit;
    if (open(my $pipe, "-|", "pacman", "-Qqe")) {
      while (<$pipe>) { chomp; $explicit{$_} = 1; }
      close($pipe);
    }
    my @out;
    for my $dir (glob("/var/lib/pacman/local/*")) {
      if (open(my $fh, "<", "$dir/desc")) {
        my ($name, $desc);
        while (<$fh>) {
          chomp;
          if ($_ eq "%NAME%") { $name = <$fh>; chomp($name); }
          elsif ($_ eq "%DESC%") { $desc = <$fh>; chomp($desc); }
          last if ($name && $desc);
        }
        close($fh);
        if ($name && $explicit{$name}) {
          $desc //= $name;
          $desc =~ s/[:\[\]\x00-\x1f]/ /g;
          push @out, "$name:$desc\n";
        }
      }
    }
    print @out;
  ' 2>/dev/null)

  if [[ -n "$pkg_data" ]]; then
    pkgs=( ${(f)pkg_data} )
    _describe -t explicitly-installed 'explicitly installed package' pkgs
  else
    _yay_installed_packages
  fi
}

# Dynamic completion for installable packages (Repo + AUR)
# Reads ~/.cache/yay/completion.cache or yay -Pc cleanly without repo clutter
_yay_installable_packages() {
  local -a seq sep packages repositories
  if [[ ${words[CURRENT-1]} == '--ignore' ]]; then
    seq='_sequence'
    sep=(-S ',')
  else
    seq=
    sep=()
  fi

  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/yay/completion.cache"

  if compset -P1 '*/*'; then
    local repo_target="${words[CURRENT]%/*}"
    if [[ -f "$cache_file" ]]; then
      packages=( ${(f)"$(awk -F'\t' -v r="$repo_target" '$2==r {print $1}' "$cache_file" 2>/dev/null)"} )
    else
      packages=( ${(f)"$(yay -Pc "$repo_target" 2>/dev/null | awk -F'\t' '{print $1}')"} )
    fi
    typeset -U packages
    ${seq} _wanted repo_packages expl "repository/package" compadd ${sep[@]} - "${(@)packages}"
  else
    if [[ -f "$cache_file" ]]; then
      packages=( ${(f)"$(cut -f1 "$cache_file" 2>/dev/null)"} )
    else
      packages=( ${(f)"$(yay -Pc 2>/dev/null | awk -F'\t' '{print $1}')"} )
    fi
    typeset -U packages
    ${seq} _wanted packages expl "packages" compadd ${sep[@]} - "${(@)packages}"

    repositories=( $(pacman-conf --repo-list 2>/dev/null) )
    typeset -U repositories
    _wanted repo_packages expl "repository/package" compadd -S "/" $repositories
  fi
}

# Dynamic completion for package groups
_yay_completions_all_groups() {
  local -a cmd groups
  _pacman_get_command
  groups=( $(_call_program groups $cmd[@] -Sg 2>/dev/null) )
  typeset -U groups

  if [[ ${words[CURRENT-1]} == '--ignoregroup' ]]; then
    _sequence compadd -S ',' "$@" -a groups
  else
    compadd "$@" -a groups
  fi
}

_yay_completions_installed_groups() {
  local -a cmd groups
  _pacman_get_command
  groups=( ${(o)${(f)"$(_call_program groups $cmd[@] -Qg 2>/dev/null)"}% *} )
  typeset -U groups
  compadd "$@" -a groups
}

_yay_all_packages() {
  _alternative : \
    'installed-packages:installed package:_yay_installed_packages' \
    'packages:installable package:_yay_installable_packages'
}

_yay_completions_repositories() {
  local -a repositories
  repositories=( $(pacman-conf --repo-list 2>/dev/null) )
  typeset -U repositories
  compadd "$@" -a repositories
}

# Helper to build command context
_pacman_get_command() {
  cmd=( "pacman" "2>/dev/null" )
  integer i
  for (( i = 2; i < CURRENT - 1; i++ )); do
    if [[ ${words[i]} = "--config" || ${words[i]} = "--root" ]]; then
      cmd+=( ${words[i,i+1]} )
    fi
  done
}

