# ----------------------------------------------------------------------
# Subcommand Action Handlers
# ----------------------------------------------------------------------

_pacman_action_help() {
  _arguments -s : "$_pacman_opts_commands[@]"
}

_pacman_action_none() {
  _arguments -s -S -C : \
    "$_pacman_opts_commands[@]" \
    "$_pacman_opts_common[@]" \
    '*:installable package:_yay_installable_packages'
}

_pacman_action_query() {
  local context state line
  typeset -A opt_args

  case $state in
    query_file)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:package file:_files -g "*.pkg.tar*~*.sig(.,@)"'
      ;;
    query_group)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:groups:_yay_completions_installed_groups'
      ;;
    query_owner)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:file:_files'
      ;;
    query_search)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:search text: '
      ;;
    *)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_actions[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:installed package:_yay_installed_packages'
      ;;
  esac
}

_pacman_action_remove() {
  _arguments -s : \
    '(--remove -R)'{-R,--remove} \
    "$_pacman_opts_common[@]" \
    "$_pacman_opts_remove[@]"
}

_pacman_action_database() {
  _arguments -s : \
    '(--database -D)'{-D,--database} \
    "$_pacman_opts_common[@]" \
    "$_pacman_opts_database[@]"
}

_pacman_action_files() {
  _arguments -s : \
    '(--files -F)'{-F,--files} \
    "$_pacman_opts_common[@]" \
    "$_pacman_opts_files[@]"
}

_pacman_action_deptest () {
  _arguments -s : \
    '(--deptest)-T' \
    "$_pacman_opts_common[@]" \
    ":packages:_yay_all_packages"
}

_pacman_action_build() {
  _arguments -s : \
    '(-B --build)'{-B,--build} \
    "$_pacman_opts_common[@]" \
    "$_pacman_opts_build_modifiers[@]"
}

_pacman_action_sync() {
  local context state line
  typeset -A opt_args
  if (( $+words[(r)--clean] )); then
    state=sync_clean
  elif (( $+words[(r)--groups] )); then
    state=sync_group
  elif (( $+words[(r)--search] )); then
    state=sync_search
  fi

  case $state in
    sync_clean)
      _arguments -s : \
        {\*-c,\*--clean}'[Remove old packages from cache]' \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]"
      ;;
    sync_group)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '(-g --group)'{-g,--groups} \
        '*:package group:_yay_completions_all_groups'
      ;;
    sync_search)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '*:search text: '
      ;;
    *)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_actions[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '*:installable package:_yay_installable_packages'
      ;;
  esac
}

_pacman_action_upgrade() {
  _arguments -s : \
    '(-U --upgrade)'{-U,--upgrade} \
    "$_pacman_opts_common[@]" \
    "$_pacman_opts_pkgfile[@]"
}

_pacman_action_version() {
  return 0
}

# ----------------------------------------------------------------------
# Main Dispatcher
# ----------------------------------------------------------------------

_pacman_zsh_comp() {
  local -a args cmds
  local tmp
  args=( ${${${(M)words:#-*}#-}:#-*} )
  for tmp in $words; do
    cmds+=("${${_pacman_opts_commands[(r)*$tmp\[*]%%\[*}#*\)}")
  done

  case $args in
    h*)
      if (( ${(c)#args} <= 1 && ${(w)#cmds} <= 1 )); then
        _pacman_action_help
      else
        _message "no more arguments"
      fi
      ;;
    *h*)
      _message "no more arguments"
      ;;
    D*)
      _pacman_action_database
      ;;
    F*)
      _pacman_action_files
      ;;
    Q*g*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:groups:_yay_completions_installed_groups'
      ;;
    Q*o*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:package file:_files'
      ;;
    Q*p*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_query_modifiers[@]" \
        '*:package file:_files -g "*.pkg.tar*~*.sig(.,@)"'
      ;;
    Q*)
      _pacman_action_query
      ;;
    B*)
      _pacman_action_build
      ;;
    P*)
      _arguments -s : \
        '-P' \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_print_modifiers[@]"
      ;;
    W*)
      _arguments -s : \
        '-W' \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_web_modifiers[@]"
      ;;
    R*)
      _pacman_action_remove
      ;;
    S*c*)
      _arguments -s : \
        '(-c --clean)'{\*-c,\*--clean}'[Remove all files from the cache]' \
        "$_pacman_opts_common[@]"
      ;;
    S*l*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '*:package repo:_yay_completions_repositories'
      ;;
    S*g*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '*:package group:_yay_completions_all_groups'
      ;;
    S*s*)
      _arguments -s : \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_sync_modifiers[@]" \
        '*:search text: '
      ;;
    S*)
      _pacman_action_sync
      ;;
    T*)
      _pacman_action_deptest
      ;;
    U*)
      _pacman_action_upgrade
      ;;
    V*)
      _pacman_action_version
      ;;
    Y*)
      _arguments -s : \
        '-Y' \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_yay_modifiers[@]"
      ;;
    G*)
      _arguments -s : \
        '-G' \
        "$_pacman_opts_common[@]" \
        "$_pacman_opts_getpkgbuild_modifiers[@]"
      ;;
    *)
      case ${(M)words:#--*} in
        *--help*)
          if (( ${(w)#cmds} == 1 )); then
            _pacman_action_help
          else
            return 0
          fi
          ;;
        *--sync*)
          _pacman_action_sync
          ;;
        *--query*)
          _pacman_action_query
          ;;
        *--build*)
          _pacman_action_build
          ;;
        *--remove*)
          _pacman_action_remove
          ;;
        *--deptest*)
          _pacman_action_deptest
          ;;
        *--database*)
          _pacman_action_database
          ;;
        *--files*)
          _pacman_action_files
          ;;
        *--version*)
          _pacman_action_version
          ;;
        *--upgrade*)
          _pacman_action_upgrade
          ;;
        *)
          _pacman_action_none
          ;;
      esac
      ;;
  esac
}

_yay() {
  case "$service" in
    yay)
      _pacman_zsh_comp "$@"
      ;;
    *)
      _message "Error"
      ;;
  esac
}

_yay "$@"
