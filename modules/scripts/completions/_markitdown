#compdef markitdown

zstyle ':completion:*:*:markitdown:*' prefix-needed false

_markitdown() {
  _arguments -s -S \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version]' \
    '(-o --output)'{-o,--output}'=[Output file name]:output:_files' \
    '(-x --extension)'{-x,--extension}'=[Hint about file extension]:ext:' \
    '(-m --mime-type)'{-m,--mime-type}'=[Hint about MIME type]:mime:' \
    '1:filename:_files'
}

_markitdown "$@"
