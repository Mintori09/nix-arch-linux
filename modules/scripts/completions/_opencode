# ----------------------------------------------------------------------
# Main Dispatcher
# ----------------------------------------------------------------------

_opencode() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  # Enable prefix-needed false to display flags alongside subcommands on Tab
  zstyle ":completion:*:*:opencode:*" prefix-needed false

  local -a global_opts
  global_opts=(
    '(-h --help)'{-h,--help}'[Show help]'
    '(-v --version)'{-v,--version}'[Show version number]' \
    '--print-logs[Print logs to stderr]' \
    '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
    '--pure[Run without external plugins]' \
    '--port=[Port to listen on]:port:' \
    '--hostname=[Hostname to listen on]:hostname:' \
    '--mdns[Enable mDNS service discovery]' \
    '--mdns-domain=[Custom domain name for mDNS]:domain:' \
    '*--cors=[Additional domain to allow for CORS]:domain:' \
    '(-m --model)'{-m+,--model=}'[Model to use (provider/model)]:model:_opencode_models' \
    '(-c --continue)'{-c,--continue}'[Continue the last session]' \
    '(-s --session)'{-s+,--session=}'[Session id to continue]:session ID:_opencode_sessions' \
    '--fork[Fork session when continuing (use with -c or -s)]' \
    '--prompt=[Prompt to use]:prompt:' \
    '--agent=[Agent to use]:agent:_opencode_agents' \
    '--auto[Auto-approve permissions not explicitly denied]' \
    '--mini[Start minimal interactive interface]' \
    '--no-replay[Disable mini session history replay]' \
    '--replay-limit=[Cap visible mini replay to newest N messages]:number:'
  )

  _arguments -s -S -C \
    "$global_opts[@]" \
    '1:subcommand or project path:->subcmd_or_dir' \
    '*::subcommand arguments:->subargs' && ret=0

  case "$state" in
    subcmd_or_dir)
      local -a subcommands
      subcommands=(
        'run:Run opencode with a message'
        'attach:Attach to a running opencode server'
        'models:List all available models'
        'session:Manage sessions'
        'mcp:Manage MCP servers'
        'debug:Debugging and troubleshooting tools'
        'providers:Manage AI providers and credentials'
        'auth:Manage AI providers and credentials'
        'agent:Manage agents'
        'db:Database tools and sqlite queries'
        'stats:Show token usage and cost statistics'
        'export:Export session data as JSON'
        'import:Import session data from JSON file or URL'
        'github:Manage GitHub agent'
        'pr:Fetch and checkout GitHub PR branch, then run opencode'
        'plugin:Install plugin and update config'
        'plug:Install plugin and update config'
        'serve:Start a headless opencode server'
        'web:Start opencode server and open web interface'
        'acp:Start ACP (Agent Client Protocol) server'
        'upgrade:Upgrade opencode version'
        'uninstall:Uninstall opencode'
        'completion:Generate shell completion script'
      )
      _describe -t subcommands 'opencode subcommand' subcommands
      _files -/
      ret=0
      ;;
    subargs)
      case "$words[1]" in
        run)
          _opencode_run && ret=0
          ;;
        attach)
          _opencode_attach && ret=0
          ;;
        mcp)
          _opencode_mcp && ret=0
          ;;
        debug)
          _opencode_debug && ret=0
          ;;
        providers|auth)
          _opencode_providers_cmd && ret=0
          ;;
        agent)
          _opencode_agent_cmd && ret=0
          ;;
        session)
          _opencode_session_cmd && ret=0
          ;;
        db)
          _opencode_db && ret=0
          ;;
        models)
          _opencode_models_cmd && ret=0
          ;;
        stats)
          _opencode_stats && ret=0
          ;;
        export)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '--sanitize[Redact sensitive transcript and file data]' \
            '1:session ID:_opencode_sessions' && ret=0
          ;;
        import)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '1:JSON file or share URL:_files' && ret=0
          ;;
        github)
          _opencode_github && ret=0
          ;;
        pr)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '1:PR number:' && ret=0
          ;;
        plugin|plug)
          _opencode_plugin_cmd && ret=0
          ;;
        serve|web|acp)
          _opencode_server_options && ret=0
          ;;
        upgrade)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '(-m --method)'{-m+,--method=}'[Installation method]:method:(curl npm pnpm bun brew choco scoop)' \
            '1:version target:' && ret=0
          ;;
        uninstall)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '(-c --keep-config)'{-c,--keep-config}'[Keep configuration files]' \
            '(-d --keep-data)'{-d,--keep-data}'[Keep session data and snapshots]' \
            '--dry-run[Show what would be removed without removing]' \
            '(-f --force)'{-f,--force}'[Skip confirmation prompts]' && ret=0
          ;;
        completion)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' && ret=0
          ;;
        *)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '*:arguments:_files' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_opencode "$@"
