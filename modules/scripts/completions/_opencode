_opencode_mcp() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version number]' \
    '--print-logs[Print logs to stderr]' \
    '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
    '--pure[Run without external plugins]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->args' && ret=0

  case "$state" in
    subcmd)
      local -a mcp_cmds
      mcp_cmds=(
        'add:Add an MCP server'
        'list:List MCP servers and their status'
        'ls:List MCP servers and their status'
        'auth:Authenticate with an OAuth-enabled MCP server'
        'logout:Remove OAuth credentials for an MCP server'
        'debug:Debug OAuth connection for an MCP server'
      )
      _describe -t commands 'mcp subcommand' mcp_cmds && ret=0
      ;;
    args)
      case "$words[1]" in
        add)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '--url=[URL for a remote MCP server]:remote URL:' \
            '*--env=[Environment variable for a local MCP server (KEY=VALUE)]:env variable:' \
            '*--header=[HTTP header for a remote MCP server (KEY=VALUE)]:header:' \
            '1:server name:' && ret=0
          ;;
        list|ls)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' && ret=0
          ;;
        auth)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '1:server name or list:((list\:"List OAuth-capable servers" ls\:"List OAuth-capable servers"))' && ret=0
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '1:server name:_opencode_mcp_servers' && ret=0
          ;;
        debug)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' \
            '(-v --version)'{-v,--version}'[Show version number]' \
            '--print-logs[Print logs to stderr]' \
            '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
            '--pure[Run without external plugins]' \
            '1:server name:_opencode_mcp_servers' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

