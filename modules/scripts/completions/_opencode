  _arguments -C \
    '(-h --help)'{-h,--help}'[Show help]' \
    '(-v --version)'{-v,--version}'[Show version number]' \
    '--print-logs[Print logs to stderr]' \
    '--log-level=[Log level]:log level:(DEBUG INFO WARN ERROR)' \
    '--pure[Run without external plugins]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->args' && ret=0

  case "$state" in
    subcmd)
      local -a debug_cmds
      debug_cmds=(
        'config:Show resolved configuration'
        'lsp:LSP debugging utilities'
        'rg:Ripgrep debugging utilities'
        'file:File system debugging utilities'
        'scrap:List all known projects'
        'skill:List all available skills'
        'snapshot:Snapshot debugging utilities'
        'startup:Print startup timing'
        'agent:Show agent configuration details'
        'v2:Debug v2 catalog and built-in plugins'
        'info:Show debug information'
        'paths:Show global paths (data, config, cache, state)'
        'wait:Wait indefinitely (for debugging)'
      )
      _describe -t commands 'debug subcommand' debug_cmds && ret=0
      ;;
    args)
      case "$words[1]" in
        lsp)
          _arguments \
            '1:subcommand:(diagnostics symbols document-symbols)' \
            '2:argument:_files' && ret=0
          ;;
        rg)
          _arguments \
            '1:subcommand:(files search)' \
            '2:pattern:' && ret=0
          ;;
        file)
          _arguments \
            '1:subcommand:(read list search)' \
            '2:path or query:_files' && ret=0
          ;;
        snapshot)
          _arguments \
            '1:subcommand:(track patch diff)' \
            '2:hash:' && ret=0
          ;;
        agent)
          _arguments \
            '--tool=[Tool id to execute]:tool id:' \
            '--params=[Tool params as JSON]:params:' \
            '1:agent name:_opencode_agents' && ret=0
          ;;
        *)
          _arguments \
            '(-h --help)'{-h,--help}'[Show help]' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

