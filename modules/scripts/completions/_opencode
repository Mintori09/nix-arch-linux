# Dynamic models completion with 24h caching + background refresh
_opencode_models() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/opencode"
  local cache_file="$cache_dir/models.cache"
  local -a models
  local now=$(date +%s)
  local mtime=0

  if [[ -f "$cache_file" ]]; then
    mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
  fi

  # If cache file missing or empty, fetch synchronously once
  if [[ ! -s "$cache_file" ]]; then
    mkdir -p "$cache_dir" 2>/dev/null
    local raw_models
    raw_models=$(opencode models 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+')
    if [[ -n "$raw_models" ]]; then
      printf '%s\n' "$raw_models" > "$cache_file" 2>/dev/null
    fi
  elif (( now - mtime > 86400 )); then
    # If expired (> 24h), refresh in background so tab completion is always instantaneous
    (
      setopt localoptions no_notify no_monitor 2>/dev/null
      local updated
      updated=$(opencode models 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+')
      [[ -n "$updated" ]] && printf '%s\n' "$updated" > "$cache_file"
    ) &!
  fi

  if [[ -s "$cache_file" ]]; then
    while IFS= read -r id; do
      [[ -n "$id" ]] && models+=("${id}:${id}")
    done < "$cache_file"
  fi

  if (( ${#models} == 0 )); then
    models=(
      'opencode-go/deepseek-v4-flash:DeepSeek V4 Flash'
      'opencode-go/deepseek-v4-pro:DeepSeek V4 Pro'
      'opencode-go/glm-5.1:GLM 5.1'
      'opencode/claude-sonnet-4-6:Claude Sonnet 4.6'
      'opencode/gemini-3.8-flash:Gemini 3.8 Flash'
    )
  fi

  _describe -t models 'available model' models
}

# Dynamic session completion from opencode SQLite database
_opencode_sessions() {
  local -a sessions
  local db="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"
  if [[ -f "$db" ]] && (( $+commands[sqlite3] )); then
    local raw_sessions
    raw_sessions=$(sqlite3 -separator $'\t' "$db" "SELECT id, replace(replace(title, char(10), ' '), ':', ' - ') FROM session WHERE title IS NOT NULL AND length(title) > 0 ORDER BY time_updated DESC LIMIT 30;" 2>/dev/null | sed 's/^[│ ]*//;s/[│ ]*$//')
    if [[ -n "$raw_sessions" ]]; then
      while IFS=$'\t' read -r id title; do
        [[ -n "$id" ]] && sessions+=("${id}:${title:-session}")
      done <<< "$raw_sessions"
    fi
  fi

  if (( ${#sessions} > 0 )); then
    _describe -t sessions 'session ID' sessions
  else
    _message 'session ID'
  fi
}

# Configured MCP servers from ~/.config/opencode/config.json
_opencode_mcp_servers() {
  local -a servers
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/config.json"
  if [[ -f "$cfg" ]] && (( $+commands[jq] )); then
    local names
    names=($(jq -r '.mcp | keys[]' "$cfg" 2>/dev/null))
    for s in "${names[@]}"; do
      servers+=("${s}:MCP server")
    done
  fi

  if (( ${#servers} > 0 )); then
    _describe -t mcp-servers 'configured MCP server' servers
  else
    _message 'MCP server name'
  fi
}

