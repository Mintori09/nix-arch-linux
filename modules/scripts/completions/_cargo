    '--target=[Target triple]:target:' \
    '--rust[Show interleaved Rust source]' \
    '--simplify[Simplify output]' \
    '--everything[Show all functions]'
}

_cargo() {
  local subcmd_idx=2
  # Skip optional +toolchain argument (e.g. cargo +nightly ...)
  if (( CURRENT > 2 )) && [[ "${words[2]}" == +* ]]; then
    subcmd_idx=3
  fi

  if (( CURRENT > subcmd_idx )); then
    local subcmd="${words[$subcmd_idx]}"
    local handler="_cargo_${subcmd//-/_}"
    if (( $+functions[$handler] )); then
      local -a saved_words=("${words[@]}")
      local saved_CURRENT=$CURRENT
      words=("cargo-${subcmd}" "${words[@]:$subcmd_idx}")
      CURRENT=$(( CURRENT - subcmd_idx + 1 ))
      "$handler"
      local ret=$?
      words=("${saved_words[@]}")
      CURRENT=$saved_CURRENT
      return $ret
    fi
  fi

  _cargo_dynamic_complete
}

_cargo "$@"
