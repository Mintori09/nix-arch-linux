#compdef cargo

# Hybrid Zsh completion for Cargo:
# - Uses Cargo's built-in dynamic completer (CARGO_COMPLETE=zsh) for top-level
#   subcommands, +toolchains, aliases, and all built-in subcommands/flags/targets/features.
# - Provides dedicated _arguments completions for external cargo-* subcommands
#   (nextest, deny, audit, watch, llvm-cov, clippy, fmt, outdated, machete, bloat,
#   tarpaulin, semver-checks, flamegraph, asm) where CARGO_COMPLETE falls back.

zstyle ':completion:*:*:cargo:*' prefix-needed false

_cargo_dynamic_complete() {
  local cargo_bin
  if [[ -x "$HOME/.nix-profile/bin/cargo" ]]; then
    cargo_bin="$HOME/.nix-profile/bin/cargo"
  else
    cargo_bin="${commands[cargo]:-cargo}"
  fi

  local _CLAP_COMPLETE_INDEX=$(( CURRENT - 1 ))
  local _CLAP_IFS=$'\n'

  local -a completions
  completions=("${(@f)$( \
    _CLAP_IFS="$_CLAP_IFS" \
    _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
    CARGO_COMPLETE="zsh" \
    "$cargo_bin" -- "${words[@]}" 2>/dev/null \
  )}")

  if [[ -n "$completions" ]]; then
    local -a dirs=()
    local -a other=()
    local completion
    for completion in $completions; do
      local value="${completion%%:*}"
      if [[ "$value" == */ ]]; then
        local dir_no_slash="${value%/}"
        if [[ "$completion" == *:* ]]; then
          local desc="${completion#*:}"
          dirs+=("$dir_no_slash:$desc")
        else
          dirs+=("$dir_no_slash")
        fi
      else
        other+=("$completion")
      fi
    done
    [[ -n $dirs ]] && _describe -t values 'directories' dirs -S '/' -r '/'
    [[ -n $other ]] && _describe -t values 'values' other
    return 0
  fi

  return 1
}

# Dynamic helper: workspace packages from Cargo.toml / cargo metadata (fast grep fallback)
_cargo_workspace_packages() {
  local -a pkgs
  if [[ -f Cargo.toml ]]; then
    pkgs=(${(f)"$(cargo metadata --no-deps --format-version 1 2>/dev/null | jq -r '.packages[].name' 2>/dev/null)"})
  fi
  if (( ${#pkgs} > 0 )); then
    _describe -t packages 'package' pkgs
  else
    _message 'package name'
  fi
}

_cargo_nextest() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  _arguments -C \
    '--color=[Produce color output]:when:(auto always never)' \
    '--no-pager[Do not pipe output through a pager]' \
    '(-v --verbose)'{-v,--verbose}'[Verbose output]' \
    '(-h --help)'{-h,--help}'[Print help]' \
    '(-V --version)'{-V,--version}'[Print version]' \
    '--manifest-path=[Path to Cargo.toml]:manifest:_files -g "Cargo.toml"' \
    '--config-file=[Config file]:config:_files -g "*.toml"' \
    '--user-config-file=[User config file]:config:_files -g "*.toml"' \
    '--override-version-check[Override minimum version check]' \
    '(-P --profile)'{-P,--profile}'=[Nextest profile to use]:profile:' \
    '1:subcommand:->subcmd' \
    '*::arguments:->subargs' && ret=0

  case "$state" in
    subcmd)
      local -a subcommands
      subcommands=(
        'list:List tests in workspace'
        'run:Build and run tests'
        'r:Build and run tests (alias)'
        'bench:Build and run benchmarks'
        'b:Build and run benchmarks (alias)'
        'archive:Build and archive tests'
        'show-config:Show nextest configuration'
        'self:Manage nextest installation'
        'help:Print help'
      )
      _describe -t subcommands 'nextest subcommand' subcommands && ret=0
      ;;
    subargs)
      case "$words[1]" in
        run|r|list|bench|b)
          _arguments -s -S \
            '--color=[Produce color output]:when:(auto always never)' \
            '--no-pager[Do not pipe output through a pager]' \
            '(-v --verbose)'{-v,--verbose}'[Verbose output]' \
            '(-h --help)'{-h,--help}'[Print help]' \
            '(-p --package)'{-p,--package}'=[Package to test]:package:_cargo_workspace_packages' \
            '--workspace[Test all packages in the workspace]' \
            '--exclude=[Exclude packages from the test]:package:_cargo_workspace_packages' \
            '--lib[Test only library unit tests]' \
            '--bin=[Test only the specified binary]:bin:' \
            '--bins[Test all binaries]' \
            '--example=[Test only the specified example]:example:' \
            '--examples[Test all examples]' \
            '--test=[Test only the specified test target]:test:' \
            '--tests[Test all test targets]' \
            '--bench=[Test only the specified bench target]:bench:' \
            '--benches[Test all benches]' \
            '--all-targets[Test all targets]' \
            '(-F --features)'{-F,--features}'=[Space or comma separated list of features]:features:' \
            '--all-features[Activate all available features]' \
            '--no-default-features[Do not activate the default feature]' \
            '--build-jobs=[Number of build jobs]:jobs:' \
            '(-r --release)'{-r,--release}'[Build artifacts in release mode]' \
            '--cargo-profile=[Cargo profile]:profile:' \
            '--target=[Build for target triple]:target:' \
            '--target-dir=[Target directory]:dir:_files -/' \
            '--manifest-path=[Path to Cargo.toml]:manifest:_files -g "Cargo.toml"' \
            '--frozen[Require Cargo.lock and cache are up to date]' \
            '--locked[Require Cargo.lock is up to date]' \
            '--offline[Run without accessing the network]' \
            '(-E --filter-expr)'{-E,--filter-expr}'=[Test filter expression]:expr:' \
            '--run-ignored=[Run ignored tests]:mode:(default only all)' \
            '--partition=[Run a subset of tests]:partition:' \
            '(-j --test-threads)'{-j,--test-threads}'=[Number of tests to run simultaneously]:threads:' \
            '--retries=[Number of retries for failing tests]:count:' \
            '--fail-fast[Cancel test run on the first failure]' \
            '--no-fail-fast[Do not cancel test run on the first failure]' \
            '--no-capture[Do not capture stdout/stderr (alias for --success-output=immediate --failure-output=immediate --test-threads=1)]' \
            '--failure-output=[Output behavior for failing tests]:when:(immediate final immediate-final never)' \
            '--success-output=[Output behavior for passing tests]:when:(immediate final immediate-final never)' \
            '--status-level=[Test statuses to display]:level:(none fail retry slow leak pass skip all)' \
            '--final-status-level=[Test statuses to display at end]:level:(none fail retry slow leak pass skip all)' \
            '--cargo-message-format=[Cargo message format]:fmt:(human short json json-diagnostic-short json-diagnostic-rendered-ansi json-render-diagnostics)' \
            '--message-format=[Output format]:fmt:(human oneline json-pretty)' \
            '(-P --profile)'{-P,--profile}'=[Nextest profile]:profile:' \
            '*:filter:' && ret=0
          ;;
        *)
          _arguments '(-h --help)'{-h,--help}'[Print help]' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_cargo_deny() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args

  _arguments -C \
    '(-L --log-level)'{-L,--log-level}'=[Log level]:level:(off error warn info debug trace)' \
    '(-f --format)'{-f,--format}'=[Output format]:format:(human json sarif)' \
    '(-c --color)'{-c,--color}'=[Color output]:color:(auto always never)' \
    '--manifest-path=[Path to Cargo.toml]:manifest:_files -g "Cargo.toml"' \
    '--workspace[Use all workspace packages as roots]' \
    '--exclude=[Crates to exclude]:crate:' \
    '(-t --target)'{-t,--target}'=[Filter crates by target triple]:target:' \
    '--all-features[Activate all available features]' \
    '--no-default-features[Do not activate the default feature]' \
    '--features=[Features to activate]:features:' \
    '--frozen[Require Cargo.lock and cache are up to date]' \
    '--offline[Run without accessing the network]' \
    '--locked[Assert Cargo.lock will remain unchanged]' \
    '--exclude-dev[Exclude all dev-dependencies]' \
    '--exclude-unpublished[Exclude unpublished workspace members]' \
    '(-h --help)'{-h,--help}'[Print help]' \
    '(-V --version)'{-V,--version}'[Print version]' \
    '1:subcommand:->subcmd' \
    '*::arguments:->subargs' && ret=0

  case "$state" in
    subcmd)
      local -a subcommands
      subcommands=(
        'check:Checks a project'\''s crate graph'
        'fetch:Fetches remote data'
        'init:Creates a cargo-deny config from a template'
        'list:Outputs a listing of all licenses and crates'
        'help:Print help'
      )
      _describe -t subcommands 'deny subcommand' subcommands && ret=0
      ;;
    subargs)
      case "$words[1]" in
        check)
          _arguments -s -S \
            '(-c --config)'{-c,--config}'=[Path to deny.toml]:config:_files -g "*.toml"' \
            '--metadata-path=[Path to cargo metadata json]:json:_files -g "*.json"' \
            '(-g --graph)'{-g,--graph}'=[Path to graph output directory]:dir:_files -/' \
            '--hide-inclusion-graph[Hide inclusion graph]' \
            '(-d --disable-fetch)'{-d,--disable-fetch}'[Disable fetching advisory database]' \
            '--exclude-dev[Exclude dev-dependencies]' \
            '--audit-compatible-output[Use cargo-audit compatible output]' \
            '--show-stats[Show stats for each check]' \
            '(-h --help)'{-h,--help}'[Print help]' \
            '*:check:(advisories ban bans license licenses sources all)' && ret=0
          ;;
        fetch)
          _arguments -s -S \
            '(-c --config)'{-c,--config}'=[Path to deny.toml]:config:_files -g "*.toml"' \
            '(-h --help)'{-h,--help}'[Print help]' \
            '*:source:(db index all)' && ret=0
          ;;
        init|list)
          _arguments -s -S \
            '(-c --config)'{-c,--config}'=[Path to deny.toml]:config:_files -g "*.toml"' \
            '(-h --help)'{-h,--help}'[Print help]' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

