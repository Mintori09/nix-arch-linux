{
  "name": "generate-toc",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "generate-toc": "./bin/index.js"
  },
  "scripts": {
    "toc": "bun src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=bin/index.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "mammoth": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
