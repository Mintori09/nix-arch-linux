{
  "name": "anki-generator-node",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --external:anki-apkg-export --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-test-module-mocks --import tsx --test 'tests/**/*.test.ts'"
  },
  "main": "dist/index.js",
  "bin": {
    "anki-tool": "./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "anki-apkg-export": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
