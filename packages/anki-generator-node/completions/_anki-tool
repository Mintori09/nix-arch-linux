#compdef anki-tool

_anki_tool() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -s -S \
    '(--export --prompt --autocomplete)'{--type,-type}'[Specify parsing strategy mode]:parser type:(vocab grammar mcq mcq-shuffle mcq-listening basic jp_vocab jp_grammar)' \
    '(--export --prompt --autocomplete)'{--deck-name,-d}'[Specify custom deck name or root hierarchy]:deck name:' \
    '(--export --prompt --autocomplete)'{--watch,-w}'[Watch input files and auto rebuild APKG on change]' \
    '(--export --prompt --autocomplete)'{--preview,-p}'[Start local web preview server in browser]' \
    '(--export --prompt --autocomplete)--without-image[Skip image downloading and rendering]' \
    '(--export --prompt --autocomplete)--port[Specify port for preview server]:port number:' \
    '(--type -type --deck-name -d --watch -w --preview -p --without-image --port --prompt --autocomplete)'{--export,-export}'[Specify package deconstruction mode]:anki deck:_files -g "*.apkg"' \
    '(--type -type --deck-name -d --watch -w --preview -p --without-image --port --export -export --autocomplete)'{--prompt,-prompt}'[Output specified prompt template or list all]:prompt name:(anki-flashcard-english-vocab mcq-creation)' \
    '(--type -type --deck-name -d --watch -w --preview -p --without-image --port --export -export --prompt -prompt)'{--autocomplete,-autocomplete}'[Output the ZSH completion script to stdout]' \
    '*:JSON input file:_files -g "*.(#i)json(-.)"'
}

_anki_tool "$@" 2>/dev/null || true
